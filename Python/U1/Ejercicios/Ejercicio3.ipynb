   "source": [
    "# Cálculo del área y perímetro de un círculo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "abb72aed-b259-4a85-b7ce-73cacb5924a1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Captura el valor del radio:  3\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "El área del círculo es :  28.2744\n",
      "El perímetro del círculo es :  18.8496\n"
     ]
    }
   ],
   "source": [
    "radio = float (input ('Captura el valor del radio: '))\n",
    "area = 3.1416 * (radio**2)\n",
    "perimetro = 3.1416 * (radio*2)\n",
    "print ('El área del círculo es : ', area)\n",
    "print ('El perímetro del círculo es : ', perimetro)"
   ]
